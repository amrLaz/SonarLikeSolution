<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.2.1" />
    <PackageReference Include="Azure.Identity" Version="1.5.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="5.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="5.0.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.20.0" />
    <PackageReference Include="Polly" Version="7.2.3" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Up.France.ODI.Manufacturer.Account.Client" Version="1.1.5" />
    <PackageReference Include="Up.France.ODI.Services.Authentication.DotnetClient" Version="1.0.23022" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Up.France.ODI.Manufacturer.Account.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Up.France.ODI.Loyalty.Configuration\Up.France.ODI.Loyalty.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="nuget.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

